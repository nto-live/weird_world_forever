# Normalize line endings: let Git handle EOL, store LF in the repo.
* text=auto eol=lf

# Explicit text types (Godot + docs + tooling)
*.gd        text eol=lf
*.tscn      text eol=lf
*.tres      text eol=lf
*.godot     text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.svg       text eol=lf
*.editorconfig text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binary assets: never touch EOL, exclude from diffs
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.wav       binary
*.ogg       binary
*.mp3       binary
*.ttf       binary
*.otf       binary
*.pck       binary
*.zip       binary